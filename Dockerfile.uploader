FROM python:3.11-slim

WORKDIR /app

# 系统依赖：psycopg2 编译/运行环境
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 先复制依赖清单 → 缓存层优化构建速度
COPY requirements_uploader.txt .
RUN pip install --no-cache-dir -r requirements_uploader.txt

# 复制应用代码
COPY utils/ ./utils/

# 本地 SQLite 队列持久化目录
VOLUME ["/app"]

# 启动上传守护
CMD ["python", "-m", "utils.neon_uploader"]
