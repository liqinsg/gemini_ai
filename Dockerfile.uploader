FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_uploader.txt .
RUN pip install --no-cache-dir -r requirements_uploader.txt

# 复制文件 + 确保包结构
COPY utils/event_collector.py ./utils/
COPY utils/neon_uploader.py ./utils/
RUN touch ./utils/__init__.py

# 关键：确保数据目录存在，容器内直接用固定路径
RUN mkdir -p /app/data

# 环境变量强制覆盖数据库路径（推荐方案，最稳）
ENV DB_PATH=/app/data/event_queue.db

CMD ["python", "-m", "utils.neon_uploader"]