# =========================================================================
# run.env.example — Scheduled Runner v1.4.5 示例配置
# =========================================================================
# 复制为 run.env 后根据需要修改; 真实 run.env 已被 .gitignore 排除, 不会提交.
# 优先级: CLI 参数 > 本文件 run.env > 代码内硬编码默认值
# 注意: 仅当启动时携带 --live 时, 本文件中的新增参数才会生效;
#       未带 --live 时, 以下 MIN_GAP/MAX_ENTRIES/MC_NEUTRAL_TP/ALIGN_REQUIRED/
#       STRICT_ALIGN/GAP_THRESHOLD 均被忽略以保持向后兼容.
# =========================================================================

# -------------------------------------------------------------------------
# 1) 交易手数 (沿用既有逻辑, 无论是否 --live 都生效)
# -------------------------------------------------------------------------
# LIVE_LOT_SIZE: --live 时默认下单手数 (CLI --lots > 本值 > config_bot 默认)
LIVE_LOT_SIZE=1
# DEMO_LOT_SIZE: 非 --live (practice) 时默认下单手数
DEMO_LOT_SIZE=10000

# -------------------------------------------------------------------------
# 2) 全局 dry-run 开关
#    接受 true/false, 1/0, yes/no, on/off (大小写均可)
#    可被 CLI 的 --dry-run / --no-dry-run 覆盖
# -------------------------------------------------------------------------
DRY_RUN=false

# -------------------------------------------------------------------------
# 3) 入场筛选阈值 (仅 --live 有效)
# -------------------------------------------------------------------------
# MIN_GAP: 最小强弱缺口阈值 (USD_JPY 口径)  默认 0.9314
#   低于此值的信号视为强度不足, 不参与候选
MIN_GAP=0.9314

# GAP_THRESHOLD: 全局 GAP "强" 分类水平  默认 1.5
#   用于策略内判断信号是否够强, 作为分类门槛
GAP_THRESHOLD=1.5

# STRICT_ALIGN: 对齐阈值基准常数  默认 3.0
#   对应原 ALIGNMENT_THRESHOLD, 作为多周期对齐一致性的阈值基线
STRICT_ALIGN=3.0

# ALIGN_REQUIRED: 多周期对齐要求, 仅接受 2 或 3  默认 3
#   3 = H4 / H1 / M30 三个级别方向必须完全一致
#   2 = 多数 (2/3) 级别方向一致即可
ALIGN_REQUIRED=3

# -------------------------------------------------------------------------
# 4) 多标的入场 & 止盈调整 (仅 --live 有效)
# -------------------------------------------------------------------------
# MAX_ENTRIES: 单轮周期最多入场的有效组合数量  默认 1
#   1 = 仅取 score 最高者 (原有 top-only 行为)
#   2+ = 按 score 顺序依次尝试前 N 个合格标的, 启动时打印
#        [SELECTED] (将尝试入场) 与 [ALTERNATE] (候补池)
MAX_ENTRIES=1

# MC_NEUTRAL_TP: MC 状态为 NEUTRAL 时的 TP 倍率  默认 1.5
#   用于在中性市场环境下放大/缩小止盈距离; 1.0 表示不调整
MC_NEUTRAL_TP=1.5

# -------------------------------------------------------------------------
# 5) JPY global-extreme gate (runner 级, Layer 1, 默认开启)
# -------------------------------------------------------------------------
# JPY_REQUIRE_GLOBAL_EXTREME: runner 级 gate —— 在信号生成之前检查 JPY 在
#   全球强弱矩阵中的排名. 只有 JPY 是 TOP (1/N, 最强) 或 BOTTOM (N/N, 最弱)
#   时, JPY 组才进入正常信号生成流程; 否则整个 JPY 组 SKIP, 打印 banner
#   说明 "JPY ranks X/N, needs 1 or N" (fail closed).
#   默认 true (config_bot 默认值). 设为 false 即关闭 Layer 1 gate,
#   让 JPY 组在任何排名下都生成信号 —— 此时 Layer 2 (section 6) 是
#   唯一剩余的方向约束.
#   此 gate 的排名基准 = build_strength_matrix() 算出的 6 个币种
#   (EUR, USD, GBP, AUD, JPY, CHF).
# JPY_GATE_EXCLUDE_CURRENCIES (section 6a) 对此 gate 生效.
JPY_REQUIRE_GLOBAL_EXTREME=true

# -------------------------------------------------------------------------
# 6) JPY 极端排名方向闸门 (Layer 2, 策略内部, 方向感知, 默认关闭)
# -------------------------------------------------------------------------
# JPY_REQUIRE_EXTREME_RANK: 仅当 JPY 自身在全球强弱排名为 TOP (1/N, 最强) 或
#   BOTTOM (N/N, 最弱) 时才允许开 JPY 组新仓.
#   JPY rank=1 (最强)  → 仅允许 SELL XXX_JPY
#   JPY rank=N (最弱)  → 仅允许 BUY  XXX_JPY
#   JPY rank=2..N-1    → 不允许新 JPY 入场 (fail closed)
#   此开关是 Layer 1 (section 5) 的补充 —— Layer 1 只过不过, 这个管方向.
#   它在策略内部运行, 在 pair-level EXTREMES-ONLY 之后、JPY→OVERRIDE
#   UPGRADE 之前执行方向过滤, 确保 OVERRIDE 无法绕过方向约束. 默认 false,
#   保持与旧版本完全兼容.
# JPY_GATE_EXCLUDE_CURRENCIES (section 6a) 自动传递到此 gate,
#   两层 gate 用同一份排名基准.
JPY_REQUIRE_EXTREME_RANK=false

# -------------------------------------------------------------------------
# 6a) JPY global-extreme gate 排除币种 (Layer 1 + Layer 2 共用排名裁剪)
# -------------------------------------------------------------------------
# JPY gate 的核心逻辑是: 把 JPY 放在全球强弱矩阵里排名, 只有当它是
# TOP (1/N, 最强) 或 BOTTOM (N/N, 最弱) 时才允许新 JPY 入场.
# 排名基准是 build_strength_matrix() 算分的那 6 个币种
# (EUR, USD, GBP, AUD, JPY, CHF — 注意 NZD 不在内, 它从未进入矩阵).
#
# 某些场景下你希望 gate "忽略" 某个币种: 例如 CHF 和 JPY 在矩阵里常常
# 同时排弱侧, 导致 JPY gate 因 CHF 压制被卡住 —— 这时可以把 CHF 从
# gate 排名里去掉, 让 gate 只在剩余 5 币里判断 JPY 是否 TOP/BOTTOM.
#
# 设值方式: 逗号分隔的币种代码, 大小写不敏感, 允许多余空格.
#   默认:  不设 (或留空) → 不排除, gate 对全部 6 币排名 (历史行为)
#   例 1: JPY_GATE_EXCLUDE_CURRENCIES=CHF         → 排除 CHF
#   例 2: JPY_GATE_EXCLUDE_CURRENCIES="CHF, AUD"  → 排除 CHF 和 AUD
#
# 硬约束 (违反任一条, 程序启动时 print 错误 + sys.exit(2) → 拒绝启动):
#   • 不能排除 JPY 自身 (排除后 gate 永远找不到 JPY → 所有新 JPY 被静默挡掉)
#   • 不能排除矩阵里不存在的币种 (例如 NZD, 接受就成了 silent no-op)
#   • 排除后剩余币种必须 ≥2 ("top vs bottom" 才有意义)
#   • 排除后剩余 <4 个币 → print WARNING 但不拒绝 (gate 变得极易通过)
#
# Layer 2 一致性: 如果你同时打开了 JPY_REQUIRE_EXTREME_RANK (section 6),
# 这里设的排除集会自动传递到策略内部, 两层 gate 用同一份排名基准 ——
# 操作者不会再看到 "Layer 1 PASS 但 Layer 2 SKIP, 两个分母不一样" 的
# 困惑.
# JPY_GATE_EXCLUDE_CURRENCIES=

# -------------------------------------------------------------------------
# 6b) JPY 组强弱对比 universe 裁剪 (黑名单方式, 不改 config files)
# -------------------------------------------------------------------------
# JPY 组会自动从 config_bot_v3.STRENGTH_PAIRS 中挑出全部 _JPY 结尾的对
#   → 当前默认 4 对: USD_JPY, EUR_JPY, GBP_JPY, AUD_JPY.
# 若要在某台机器/某账户上只跑其中的子集 (例如不做 EUR 和 AUD 这种流动性
# 相对低、强弱信号"参考币种"意义更大的对), 在 JPY_SKIP_PAIRS 里列出需要
# 剔除的对, 用逗号或空格分隔 (大小写不敏感).
#   默认:  不设 (或留空) → 保留全部 4 对.
#   例 1: JPY_SKIP_PAIRS="EUR_JPY,AUD_JPY" → 只跑 USD_JPY + GBP_JPY.
#   例 2: JPY_SKIP_PAIRS="eur_jpy aud_jpy" → (同上, 大小写/分隔符无关).
#   例 3: JPY_SKIP_PAIRS="GBP_JPY"           → 保留 USD,EUR,AUD.
# 填了不存在的 pair (例如 NZD_JPY / CAD_JPY) 会打印 WARNING 后忽略
#   (fail-open, 不会误删全组). 本设置只影响 NEW signal generation,
#   SL/TP Guardian / 风险门 / early-exit / 历史遗留持仓管理不变.
# JPY_SKIP_PAIRS=""


# -------------------------------------------------------------------------
# 7) 多主机单写保护 (同 OANDA account 的跨主机双开防御, 默认关闭)
# -------------------------------------------------------------------------
# LIVE_ACCOUNT_SINGLE_HOST: 防止两台机器 (如 laptop + Oracle VM) 同时以
#   --live 连接同一 OANDA account 导致重复入场. 实现原理: 用 OANDA broker
#   本身作为共享 witness, 在每次提交 ENTRY 前扫描当前所有 bot 已持仓,
#   若发现近 SINGLE_HOST_WINDOW_MIN 分钟内有任何 bot-owned 新 open, 判定为
#   "另一台机器已在本周期入场" → fail-closed 跳过 ENTRY.
#   仅影响 ENTRY, 不影响 SL/TP Guardian / early-exit / risk 管理.
#   默认 false (多数部署场景: 不同主机连接不同 account, 互不干扰).
LIVE_ACCOUNT_SINGLE_HOST=false
# SINGLE_HOST_WINDOW_MIN: 判定「近期入场」的时间窗口 (分钟). 必须 ≥1, 默认 2.
SINGLE_HOST_WINDOW_MIN=2