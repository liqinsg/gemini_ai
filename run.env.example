# =========================================================================
# run.env.example — Scheduled Runner v1.4.5 示例配置
# =========================================================================
# 复制为 run.env 后根据需要修改; 真实 run.env 已被 .gitignore 排除, 不会提交.
# 优先级: CLI 参数 > 本文件 run.env > 代码内硬编码默认值
# 注意: 仅当启动时携带 --live 时, 本文件中的新增参数才会生效;
#       未带 --live 时, 以下 MIN_GAP/MAX_ENTRIES/MC_NEUTRAL_TP/ALIGN_REQUIRED/
#       STRICT_ALIGN/GAP_THRESHOLD 均被忽略以保持向后兼容.
# =========================================================================

# -------------------------------------------------------------------------
# 1) 交易手数 (沿用既有逻辑, 无论是否 --live 都生效)
# -------------------------------------------------------------------------
# LIVE_LOT_SIZE: --live 时默认下单手数 (CLI --lots > 本值 > config_bot 默认)
LIVE_LOT_SIZE=1
# DEMO_LOT_SIZE: 非 --live (practice) 时默认下单手数
DEMO_LOT_SIZE=10000

# -------------------------------------------------------------------------
# 2) 全局 dry-run 开关
#    接受 true/false, 1/0, yes/no, on/off (大小写均可)
#    可被 CLI 的 --dry-run / --no-dry-run 覆盖
# -------------------------------------------------------------------------
DRY_RUN=false

# -------------------------------------------------------------------------
# 3) 入场筛选阈值 (仅 --live 有效)
# -------------------------------------------------------------------------
# MIN_GAP: 最小强弱缺口阈值 (USD_JPY 口径)  默认 0.9314
#   低于此值的信号视为强度不足, 不参与候选
MIN_GAP=0.9314

# GAP_THRESHOLD: 全局 GAP "强" 分类水平  默认 1.5
#   用于策略内判断信号是否够强, 作为分类门槛
GAP_THRESHOLD=1.5

# STRICT_ALIGN: 对齐阈值基准常数  默认 3.0
#   对应原 ALIGNMENT_THRESHOLD, 作为多周期对齐一致性的阈值基线
STRICT_ALIGN=3.0

# ALIGN_REQUIRED: 多周期对齐要求, 仅接受 2 或 3  默认 3
#   3 = H4 / H1 / M30 三个级别方向必须完全一致
#   2 = 多数 (2/3) 级别方向一致即可
ALIGN_REQUIRED=3

# -------------------------------------------------------------------------
# 4) 多标的入场 & 止盈调整 (仅 --live 有效)
# -------------------------------------------------------------------------
# MAX_ENTRIES: 单轮周期最多入场的有效组合数量  默认 1
#   1 = 仅取 score 最高者 (原有 top-only 行为)
#   2+ = 按 score 顺序依次尝试前 N 个合格标的, 启动时打印
#        [SELECTED] (将尝试入场) 与 [ALTERNATE] (候补池)
MAX_ENTRIES=1

# MC_NEUTRAL_TP: MC 状态为 NEUTRAL 时的 TP 倍率  默认 1.5
#   用于在中性市场环境下放大/缩小止盈距离; 1.0 表示不调整
MC_NEUTRAL_TP=1.5
