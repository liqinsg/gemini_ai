# =========================================================================
# run.env — Scheduled Runner v1.4.5
# =========================================================================
# 优先级: CLI 参数 > 本文件 > 代码内硬编码默认值
# 注意: 仅当启动时携带 --live 时, 本文件中的新增参数才会生效;
#       未带 --live 时, 以下 MIN_GAP/MAX_ENTRIES/MC_NEUTRAL_TP/ALIGN_REQUIRED/
#       STRICT_ALIGN/GAP_THRESHOLD 均被忽略以保持向后兼容.
# =========================================================================

# -------------------------------------------------------------------------
# 1) 交易手数 (沿用既有逻辑, 无论是否 --live 都生效)
# -------------------------------------------------------------------------
LIVE_LOT_SIZE=1
DEMO_LOT_SIZE=5000

# -------------------------------------------------------------------------
# 2) 全局 dry-run 开关
# -------------------------------------------------------------------------
DRY_RUN=false

# -------------------------------------------------------------------------
# 3) 入场筛选阈值 (仅 --live 有效)
# -------------------------------------------------------------------------
MIN_GAP=0.9314
GAP_THRESHOLD=1.5
STRICT_ALIGN=3.0
ALIGN_REQUIRED=3

# -------------------------------------------------------------------------
# 4) 多标的入场 & 止盈调整 (仅 --live 有效)
# -------------------------------------------------------------------------
MAX_ENTRIES=1
MC_NEUTRAL_TP=1.5
USE_MACD=true
# cross-group net exposure per base currency (BASE value).
# Recommended BASE=2 so the STRONG_MOMENTUM / STRONG_GAP boost rules
# (Part C/D) can differentiate regimes:  BASE=2 → NEUTRAL=2 /
# STRONG_MOMENTUM=3 / STRONG_GAP=4.  Setting BASE=3 collapses the first
# two regimes into a single identical value (differentiation lost).
CROSS_MAX_NET_PER_CCY=2
# Enable / disable JPY group execution (MAINTAIN risk gates + STRATEGY
# signal generation).  Default true.  CLI --trade-jpy false overrides.
# Set to false when a DIFFERENT account/runner owns the JPY book so this
# runner never touches JPY-owned trades.
TRADE_JPY=true

# -------------------------------------------------------------------------
# 5) Safety / guard rails
# -------------------------------------------------------------------------
# SL/TP guardian behaviour: True = repair drift (default, legacy);
# False = only repair MISSING SL/TP (let risk-engine trailing drift alone).
# GUARDIAN_REPAIR_DRIFT=false

# Cap on TOTAL open override-tagged bot trades across all groups.
# 0 = disabled (default, legacy behaviour); 2 = max 2 overrides held simultaneously.
OVERRIDE_MAX_OPEN=3

# Account-guard: refuse to start unless the resolved account_id matches.
# Prevents cron-vs-interactive env drift selecting the wrong account.
# Set this to your live profile's account id when running --live.
# EXPECT_ACCOUNT_ID=001-003-21515688-002
# 总开关（默认 true，仅 --trade-jpy-only 生效，其他模式自动走原 extreme-rank）
JPY_ONLY_USE_WEIGHTED_GATE=true

# 核心门槛
JPY_WEIGHTED_PASS_THRESHOLD=1.0              # 阵营加权总分门槛
JPY_WEIGHTED_STRONG_MIN_COUNT=2              # 阵营内合格货币最小数量
JPY_WEIGHTED_CCY_MIN_ABS_SCORE=0.1           # 单货币计入的最小 |score|

# 6 货币独立权重覆盖（不写则用默认）
JPY_WEIGHTED_WEIGHT_EUR=2.0
JPY_WEIGHTED_WEIGHT_USD=1.5
JPY_WEIGHTED_WEIGHT_GBP=1.0
JPY_WEIGHTED_WEIGHT_AUD=0.5
JPY_WEIGHTED_WEIGHT_JPY=0.3
JPY_WEIGHTED_WEIGHT_CHF=0.1
