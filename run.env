# =========================================================================
# run.env — Scheduled Runner v1.4.5
# Updated: 2026-10-05  Balanced JPY Index Mode
# =========================================================================
# 优先级: CLI 参数 > 本文件 > 代码内硬编码默认值
# 注意: 仅当启动时携带 --live 时, 本文件中的新增参数才会生效;
#       未带 --live 时, 以下 MIN_GAP/MAX_ENTRIES/MC_NEUTRAL_TP/ALIGN_REQUIRED/
#       STRICT_ALIGN/GAP_THRESHOLD 均被忽略以保持向后兼容.
# =========================================================================
# -------------------------------------------------------------------------
# 1) 交易手数 (沿用既有逻辑, 无论是否 --live 都生效)
# -------------------------------------------------------------------------
# live 基数 = 并发口径下的"名义满仓手数"；prob-zone 按 MC 置信度只缩不放大 → 1..4 整数手
LIVE_LOT_SIZE=8
DEMO_LOT_SIZE=5000
# -------------------------------------------------------------------------
# 2) 全局 dry-run 开关
# -------------------------------------------------------------------------
DRY_RUN=false
# -------------------------------------------------------------------------
# 3) 入场筛选阈值 (仅 --live 有效)
# -------------------------------------------------------------------------
MIN_GAP=0.9314
GAP_THRESHOLD=1.5
STRICT_ALIGN=3.0
ALIGN_REQUIRED=3
# -------------------------------------------------------------------------
# 4) 多标的入场 & 止盈调整 (仅 --live 有效)
# -------------------------------------------------------------------------
MAX_ENTRIES=1
MC_NEUTRAL_TP=1.5
USE_MACD=true
CROSS_MAX_NET_PER_CCY=2
# 仅交易 JPY（等价于 CLI --trade-jpy-only；非 JPY 组全部跳过）
TRADE_JPY_ONLY=true
# -------------------------------------------------------------------------
# 5) JPY Composite Index — Weighted Gate Control
# -------------------------------------------------------------------------
JPY_REQUIRE_GLOBAL_EXTREME=false
JPY_ONLY_USE_WEIGHTED_GATE=true
JPY_WEIGHTED_PASS_THRESHOLD=0.8
JPY_WEIGHTED_STRONG_MIN_COUNT=2
JPY_WEIGHTED_CCY_MIN_ABS_SCORE=0.1
JPY_WEIGHTED_WEIGHT_EUR=1.4
JPY_WEIGHTED_WEIGHT_USD=1.3
JPY_WEIGHTED_WEIGHT_GBP=1.0
JPY_WEIGHTED_WEIGHT_AUD=1.2
JPY_WEIGHTED_WEIGHT_CHF=0.2
# -------------------------------------------------------------------------
# 6) Safety / guard rails
# -------------------------------------------------------------------------
OVERRIDE_MAX_OPEN=3
JPY_WEIGHT_GATE_LOG_DIR=logs/arm
JPY_WEIGHT_ALPHA=0.15
JPY_WEIGHT_DELTA_CAP=1.84
JPY_WEIGHT_SHADOW_ONLY=false
# v2 动态权重（分阵营独立归一化 + 基础权重拉平 + 强势货币权重高）——直接生效
# v1(alpha=0.15)与静态仅作 shadow 记录对比；v2 异常自动退化 v1/静态（fail-closed）
JPY_WEIGHT_V2_ENABLED=true
JPY_WEIGHT_V2_ALPHA=0.4
JPY_WEIGHT_V2_PASS_THRESHOLD=0.35
JPY_WEIGHT_V2_FLATTEN_BASE=true
# 动态仓位管理（追势减仓）：H4延伸度(extension=(close-SMA20)/ATR14)
# 追涨/追跌方向一致时：≥1ATR→半仓(0.5)，≥2ATR→再半仓(0.25)；反向回调不减。
DYNAMIC_LOT_ENABLED=true
DYNAMIC_LOT_TIER1_ATR=1.0
DYNAMIC_LOT_TIER2_ATR=2.0
DYNAMIC_LOT_MIN_SCALE=0.25
# JPY 强弱 Gate 评估时剔除的货币代码（逗号分隔；是货币代码不是货币对，不影响交易池）
JPY_GATE_EXCLUDE_CURRENCIES=CHF
ALIGNMENT_REQUIRE_MAJORITY=True
# -------------------------------------------------------------------------
# 7) 主动出局（weak-exit）软开关 —— 无条件生效（不受 --live 限制）
# -------------------------------------------------------------------------
# true  = 启用：组内支撑分垫底的持仓会被主动平掉（真平仓，非纯观察）
# false = 关闭：本轮不做主动出局（SL/TP 照常）
WEAK_EXIT_ENABLED=false
# -------------------------------------------------------------------------
# 8) MC regime → 最小仓位 / 阶梯补仓 —— 无条件生效（不受 --live 限制）
# -------------------------------------------------------------------------
# true  = 启用：新开仓按 regime 分档（CONSOLIDATION=最小仓位 / NEUTRAL=最小×2 /
#         STRONG_MOMENTUM=最大仓位，prob-zone 只能在其上再缩）；
#         且对「regime=STRONG_MOMENTUM 且 MC 方向与持仓一致」的老仓逐轮 +1 级补仓。
# false = 关闭：整条规则休眠（新开仓沿用既有 prob-zone 手数）。
MIN_LOT_STRONG_ENABLED=true
# 最小单笔手数（阶梯基数 = 最小仓位 × 1/2/4/8）：live=1, demo=×1000。
MIN_LOT_LIVE=1
MIN_LOT_DEMO=1000


MC_TOPUP_CAP_GUARD=shadow
